APP_ENV=development
BACKEND_PORT=8000

# server domain name (register domain pointing to server)
CADDY_DOMAIN=

# telegram user ids with admin access (get from @userinfobot)
ADMIN_TELEGRAM_IDS=

# telegram bot token (get from @botfather)
TELEGRAM_BOT_TOKEN=

# telegram bot username (configure in @botfather)
TELEGRAM_BOT_USERNAME=

# telegram mini app URL link (configure in @botfather settings)
TELEGRAM_MINI_APP_URL=

# security (generate jwt secret with 'openssl rand -hex 32')
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# database host and credentials (generate secure password)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wished
POSTGRES_USER=wished
POSTGRES_PASSWORD=

# database connection url (format: postgresql+asyncpg://user:pass@host:port/db)
DATABASE_URL=

# redis host and credentials (generate secure password)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# minio credentials (generate secure access and secret keys)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_MEDIA_BUCKET=wished-media

# cors origins allowed to connect (e.g. ["https://wished.example.com"])
ALLOWED_ORIGINS=

# frontend public configuration (must match corresponding backend variables above)
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_TELEGRAM_MOCK=0
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_DEV_ORIGINS=

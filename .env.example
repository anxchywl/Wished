# application settings
APP_ENV=development
BACKEND_PORT=8000

# server and domain: CADDY_DOMAIN (register domain pointing to server)
CADDY_DOMAIN=

# telegram configuration: TELEGRAM_BOT_TOKEN (get from @botfather), TELEGRAM_BOT_USERNAME (configure in @botfather), TELEGRAM_MINI_APP_URL (configure in @botfather settings), ADMIN_TELEGRAM_IDS (get from @userinfobot)
ADMIN_TELEGRAM_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=

# app security: JWT_SECRET_KEY (generate jwt secret with openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# postgresql configuration: POSTGRES_PASSWORD (generate secure password), DATABASE_URL (format: postgresql+asyncpg://user:pass@host:port/db)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wished
POSTGRES_USER=wished
POSTGRES_PASSWORD=
DATABASE_URL=

# redis configuration: REDIS_PASSWORD (generate secure password)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# minio object storage: MINIO_ACCESS_KEY (generate secure access key), MINIO_SECRET_KEY (generate secure secret key)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_MEDIA_BUCKET=wished-media

# cors and origins: ALLOWED_ORIGINS (comma-separated domains allowed to connect, e.g. ["https://wished.example.com"])
ALLOWED_ORIGINS=

# frontend public configuration: NEXT_PUBLIC_TELEGRAM_BOT_USERNAME (must match TELEGRAM_BOT_USERNAME)
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_TELEGRAM_MOCK=0
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_DEV_ORIGINS=

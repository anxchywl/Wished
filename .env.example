APP_ENV=development
APP_NAME=Wished API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

BACKEND_PORT=8000

TELEGRAM_BOT_TOKEN=
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wished
POSTGRES_USER=wished
POSTGRES_PASSWORD=wished
DATABASE_URL=postgresql+asyncpg://wished:wished@localhost:5432/wished

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wished
MINIO_SECRET_KEY=wished-password
MINIO_SECURE=false
MINIO_MEDIA_BUCKET=wished-media

ALLOWED_ORIGINS=[]

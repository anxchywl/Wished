APP_ENV=development
BACKEND_PORT=8000

# admin panel — comma-separated telegram user ids with admin access
ADMIN_TELEGRAM_IDS=

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=

# security
JWT_SECRET_KEY=change-me

# database
DATABASE_URL=postgresql+asyncpg://wished:wished@postgres:5432/wished

# redis
REDIS_URL=redis://redis:6379/0

# minio
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wished
MINIO_SECRET_KEY=wished-password
MINIO_PRESIGNED_URL_EXPIRES_SECONDS=3600

# media upload limits
MAX_IMAGES_PER_WISH=5
UPLOAD_RATE_PER_MINUTE=20
UPLOAD_RATE_PER_HOUR=100

# cors
ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","https://your-tunnel.trycloudflare.com"]

# frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_TELEGRAM_MOCK=0
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_DEV_ORIGINS=your-tunnel.trycloudflare.com

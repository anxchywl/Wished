APP_ENV=development
APP_NAME=Wished API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# admin panel — comma-separated telegram user ids with admin access
ADMIN_TELEGRAM_IDS=

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=

# security
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wished
POSTGRES_USER=wished
POSTGRES_PASSWORD=replace-with-a-secure-password
DATABASE_URL=postgresql+asyncpg://wished:replace-with-a-secure-password@postgres:5432/wished

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wished
MINIO_SECRET_KEY=replace-with-a-secure-secret
MINIO_SECURE=false
MINIO_MEDIA_BUCKET=wished-media
MINIO_PRESIGNED_URL_EXPIRES_SECONDS=3600

# media upload limits
MAX_IMAGES_PER_WISH=5
UPLOAD_RATE_PER_MINUTE=20
UPLOAD_RATE_PER_HOUR=100

# cors
ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","https://your-tunnel.trycloudflare.com"]

# frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_TELEGRAM_MOCK=0
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_DEV_ORIGINS=your-tunnel.trycloudflare.com

# backup (production only)
# host directory for local backups — survives docker compose down -v
BACKUP_LOCAL_PATH=/var/backups/wished
# how often to run backups in seconds (21600 = 6h, 86400 = 24h)
BACKUP_INTERVAL_SECONDS=21600
# how many days of local backups to keep
BACKUP_RETENTION_DAYS=7
# verify-backup fails if latest backup is older than this many seconds (79200 = 22h)
BACKUP_MAX_AGE_SECONDS=79200

# external backup storage — set to true and provide S3-compatible credentials
# to copy backups off the server (required for surviving complete server loss)
BACKUP_EXTERNAL_ENABLED=false
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=wished-backups

# heartbeat URL pinged after every successful backup (healthchecks.io, BetterUptime, etc.)
# leave empty to disable; alerts you when backups silently stop
BACKUP_HEARTBEAT_URL=

# optional residential proxy for Kaspi (datacenter IPs are rate-limited by kaspi.kz)
# sign up at webshare.io (free tier: 1GB/month) and set the proxy URL
# format: http://user:pass@proxy.webshare.io:80
KASPI_PROXY_URL=

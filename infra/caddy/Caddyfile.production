# This file fronts seven separate compose projects on one host: wished, loci,
# muto, gradus, events_bot, gdg and clavis. Every project reaches Caddy over the
# shared wished_wished-app network.
#
# Rule for this file: address every upstream by CONTAINER NAME, never by a bare
# compose service name. Compose always registers a service's own name as a
# network alias and gives no way to suppress it, so two projects that each
# name a service the same thing make that name ambiguous on the shared network
# — Docker's embedded DNS then round-robins and requests land on whichever app
# answers. Nothing errors; the wrong app simply 404s a route it never had.
#
# This is not hypothetical. On 2026-09-12 `backend` resolved to three
# containers (wished, muto, gradus) and roughly two of every three Wished API
# calls — including POST /auth/telegram — were answered by Muto or Gradus,
# which broke Telegram login intermittently for everyone. `web` was ambiguous
# the same way between loci and events_bot, harmless only because both site
# blocks below already used container names.
#
# Those services have since been renamed to muto-api, gradus-api, loci-web and
# events-web, so no name on the network is ambiguous today. The rule stands
# anyway: it is what keeps the next project added here from resurrecting the
# bug. scripts/check-caddy-upstreams.sh enforces it on every deploy.

# Global options: connection/slow-attack hardening at the edge.
# read_header guards against Slowloris (slow header dribbling); read_body
# guards slow-body POST floods; idle reaps idle keep-alive connections so
# they can't be held open to exhaust the connection table.
{
    servers {
        timeouts {
            read_body   10s
            read_header 5s
            idle        120s
        }
        max_header_size 32KB
    }
}

{$CADDY_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # conservative CSP: blocks plugins and <base>-tag/href injection without
        # constraining script/style sources, so the Next.js app is unaffected
        Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        -Server
        # don't advertise the framework/version to attackers
        -X-Powered-By
    }

    # compress responses at the edge (JSON API + HTML/JS); Caddy skips
    # already-compressed types like images, so media objects pass through untouched
    encode zstd gzip

    request_body {
        max_size 10MB
    }

    # API requests to the backend (container name — see the note at the top)
    handle /api/* {
        reverse_proxy wished-backend:8000
    }

    # MinIO media objects — presigned URLs use this origin as the public endpoint.
    # Set MINIO_PUBLIC_ENDPOINT=https://{$CADDY_DOMAIN} so generated URLs resolve here.
    handle /wished-media/* {
        reverse_proxy wished-minio:9000
    }

    # Everything else goes to the frontend
    handle {
        reverse_proxy wished-frontend:3000
    }

    log {
        output stderr
        format json
    }
}

# NU Events Telegram Mini App (separate compose project: events_bot).
# This single Caddy instance fronts both apps. events_bot_web joins Wished's
# proxy network (wished_wished-app) for ingress only — its DB/Redis stay
# isolated on the events_bot_default network.
events.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }

    encode zstd gzip

    request_body {
        max_size 10MB
    }

    reverse_proxy events_bot_web:8000

    log {
        output stderr
        format json
    }
}

# Bare apex and www both resolve to this host but had no site block, so visitors
# hitting them got a TLS handshake error. Canonicalize them to the Wished app.
anxchywl.dev, www.anxchywl.dev {
    redir https://wished.anxchywl.dev{uri} permanent
}

# Loci Telegram Mini App (separate compose project: loci).
# This shared Caddy instance fronts Loci because ports 80/443 are already owned here.
loci.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }

    encode zstd gzip

    request_body {
        max_size 10MB
    }

    handle /api/* {
        reverse_proxy loci-api-1:8000
    }

    handle /health {
        reverse_proxy loci-api-1:8000
    }

    handle {
        reverse_proxy loci-web:3000
    }

    log {
        output stderr
        format json
    }
}

# Muto marketplace API (separate compose project: muto).
# This shared Caddy instance fronts Muto because ports 80/443 are already owned here.
muto.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }

    encode zstd gzip

    request_body {
        max_size 10MB
    }

    reverse_proxy muto-api:8000

    log {
        output stderr
        format json
    }
}

# Gradus GPA API (separate compose project: gradus).
# This shared Caddy instance fronts Gradus because ports 80/443 are already owned here.
gradus.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }

    encode zstd gzip

    # the service caps a syllabus upload at 4 MB itself; this rejects anything
    # far past that at the edge, before it reaches the app
    request_body {
        max_size 6MB
    }

    reverse_proxy gradus-api:8000

    log {
        output stderr
        format json
    }
}

# GDG datathon sponsorship site (separate compose project: gdg).
# A static Caddy container; it sets its own CSP and security headers.
gdg.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    request_body {
        max_size 1KB
    }

    reverse_proxy gdg-web:8080

    log {
        output stderr
        format json
    }
}

# Clavis piano room booking API (separate compose project: clavis).
# The service sets its own security headers; a booking body is a slot id.
clavis.anxchywl.dev {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
        -X-Powered-By
    }

    encode zstd gzip

    request_body {
        max_size 64KB
    }

    reverse_proxy clavis-api:8000

    log {
        output stderr
        format json
    }
}
